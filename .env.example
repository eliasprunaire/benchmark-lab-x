# Copier ce fichier vers .env et renseigner uniquement les accès utilisés
# Le fichier .env reste privé et ignoré par Git
# Charger avec : uv run --env-file .env python -m benchmark_lab_x.runtime ...

# Canal principal
OPENROUTER_API_KEY=

# Secours par API officielle, facultatifs
# Sélection et admission explicites requises avant utilisation
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
TENCENT_TOKENHUB_API_KEY=

