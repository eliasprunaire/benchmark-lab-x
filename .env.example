# Copier ce fichier vers .env et renseigner uniquement les accès utilisés
# Le fichier .env reste privé et ignoré par Git
# Charger avec : uv run --env-file .env python -m benchmark_lab_x.runtime ...

# Canal principal
OPENROUTER_API_KEY=

# Secours par API officielle, facultatifs
# Sélection et admission explicites requises avant utilisation
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=

# Accès directs futurs, emplacements seulement : transports non raccordés
# OpenRouter reste le canal utilisé ; aucune de ces clés n’est requise pour lui
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
HUNYUAN_API_KEY=
