# Copier ce fichier vers .env et renseigner uniquement les accès utilisés
# Le fichier .env reste privé et ignoré par Git
# Charger avec : uv run --env-file .env python -m benchmark.runtime ...

# Canal principal
OPENROUTER_API_KEY=

# Aide sémantique facultative (TypeSafe/Jev), réservée à l'exécuteur.
# Lue seulement si un profil active au moins un usage ; le service reste
# désactivé sans profil. Aucun appel n'est émis par la consultation ordinaire.
# benchmark.vault_env injecte JEV_API_KEY, mais le runtime ne lit pas ce nom : il lit TYPESAFE_API_KEY.
TYPESAFE_API_KEY=

# Chiffrement de l'accès OpenRouter délégué aux demandeurs : 64 caractères
# hexadécimaux (32 octets). Facultatif pour démarrer l'exécuteur ; son absence
# ferme les routes d'accès délégué
BENCHMARK_ACCESS_SECRET=

# Secours par API officielle, facultatifs
# Sélection et admission explicites requises avant utilisation
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
TENCENT_TOKENHUB_API_KEY=
TENCENT_TOKENHUB_BASE_URL=

# Injectés par benchmark.vault_env, non lus par le runtime courant : réservés à de futurs transports.
GROK_API_KEY=
MINIMAX_API_KEY=
MISTRAL_API_KEY=

# Ni injecté par benchmark.vault_env ni lu par le runtime courant.
MIMO_API_KEY=

# Exploitation, facultatif. Ces lignes restent commentées : une valeur vide copiée dans .env
# est exportée telle quelle, et une concurrence vide empêche l'exécuteur de démarrer.
# Journal des révocations, chemin absolu hors du stockage. Absent : privacy-revocations/revocations.jsonl à côté du stockage.
# BENCHMARK_PRIVACY_JOURNAL=
# Nombre de tâches simultanées de l'exécuteur, entier de 1 à 999. Absent : 64.
# BENCHMARK_EXECUTOR_WORKERS=
# Binaire Vault de benchmark.vault_env, lu dans l'environnement du shell. Absent : vault, résolu par le PATH.
# VAULT_BIN=
# Fichier lu par benchmark.vault_env, choisi dans l'environnement du shell. Absent : ./.env du répertoire courant.
# BENCHMARK_ENV_FILE=
