# Copier ce fichier vers .env et renseigner uniquement les accès utilisés
# Le fichier .env reste privé et ignoré par Git
# Charger avec : uv run --env-file .env python -m benchmark.runtime ...

# Canal principal
OPENROUTER_API_KEY=

# Chiffrement de l'accès OpenRouter délégué aux demandeurs : 64 caractères
# hexadécimaux (32 octets). Facultatif pour démarrer l'exécuteur ; son absence
# ferme les routes d'accès délégué
BENCHMARK_ACCESS_SECRET=

# Secours par API officielle, facultatifs
# Sélection et admission explicites requises avant utilisation
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
TENCENT_TOKENHUB_API_KEY=
TENCENT_TOKENHUB_BASE_URL=
